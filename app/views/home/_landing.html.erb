<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 md:px-8 md:py-12">
  <div class="grid grid-cols-1 items-center gap-10 sm:grid-cols-2 md:gap-16">
    
    <!-- Content -->
    <div class="flex flex-col items-center gap-6 text-center sm:items-start sm:text-left">
      <h1 class="text-5xl font-light tracking-tight sm:text-6xl">
        Aura Notes
      </h1>

      <h2 class="text-xl font-light leading-relaxed sm:text-2xl">
        Effortlessly Organize Your Notes
      </h2>

      <div class="pt-2">
        <%= link_to "Get Started",
              new_user_registration_path,
              class: "rounded-md border border-black px-6 py-2 font-medium transition hover:bg-gray-100" %>
      </div>
    </div>

    <!-- Illustration -->
    <div class="flex justify-center sm:justify-end">
      <%= image_tag "auro_note_graphics.svg",
          alt: "Aura Notes illustration",
          class: "w-full max-w-md md:max-w-lg" %>
    </div>

  </div>
</div>