<nav class="bg-white shadow">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo --> 
      <%= link_to "Aura Notes",
              root_path,
              class: "flex shrink-0 items-center text-3xl font-medium" %>

      <!-- Navigation -->
      <div class="hidden sm:ml-6 sm:flex sm:items-center sm:gap-3">

        <% if user_signed_in? %>
          <!-- Logout -->
          <%= link_to "Log Out",
              destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "rounded-md border border-black px-6 py-2 font-medium transition hover:bg-gray-100" %>
        <% else %>
          <!-- Login -->
          <%= link_to "Log in",
              new_user_session_path,
              class: "rounded-md border border-black px-6 py-2 font-medium transition hover:bg-gray-100" %>
              
        <% end %>
      </div>
    </div>
  </div>
</nav>

