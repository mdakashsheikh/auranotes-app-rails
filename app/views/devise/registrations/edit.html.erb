<div class="min-h-[calc(100vh-4rem)] bg-gray-50 px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto w-full max-w-md">

    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-semibold tracking-tight text-gray-900">
        Edit your account
      </h1>

      <p class="mt-2 text-sm text-gray-500">
        Update your Aura Notes account information.
      </p>
    </div>

    <!-- Form Card -->
    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: {
          method: :put,
          class: "space-y-5"
        }
      ) do |f| %>

        <!-- Email -->
        <div>
          <%= f.label :email,
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "you@example.com",
              class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-2 focus:ring-black/10" %>
        </div>

        <!-- Pending confirmation -->
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="rounded-xl border border-yellow-200 bg-yellow-50 px-4 py-3 text-sm text-yellow-800">
            Currently waiting confirmation for:
            <span class="font-medium">
              <%= resource.unconfirmed_email %>
            </span>
          </div>
        <% end %>

        <!-- Password -->
        <div>
          <div class="mb-2 flex items-center justify-between gap-3">
            <%= f.label :password,
                class: "block text-sm font-medium text-gray-700" %>

            <span class="text-xs text-gray-400">
              Leave blank to keep current
            </span>
          </div>

          <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-2 focus:ring-black/10" %>

          <% if @minimum_password_length %>
            <p class="mt-2 text-xs text-gray-400">
              <%= @minimum_password_length %> characters minimum
            </p>
          <% end %>
        </div>

        <!-- Password Confirmation -->
        <div>
          <%= f.label :password_confirmation,
              class: "mb-2 block text-sm font-medium text-gray-700" %>

          <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "••••••••",
              class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-2 focus:ring-black/10" %>
        </div>

        <!-- Current Password -->
        <div>
          <div class="mb-2">
            <%= f.label :current_password,
                class: "block text-sm font-medium text-gray-700" %>

            <p class="mt-1 text-xs text-gray-400">
              Required to confirm your changes.
            </p>
          </div>

          <%= f.password_field :current_password,
              autocomplete: "current-password",
              placeholder: "Enter your current password",
              class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-black focus:ring-2 focus:ring-black/10" %>
        </div>

        <!-- Update Button -->
        <div class="pt-2">
          <%= f.submit "Update account",
              class: "w-full cursor-pointer rounded-xl bg-black px-4 py-3 text-sm font-semibold text-white shadow-sm transition duration-200 hover:bg-gray-800 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2" %>
        </div>

      <% end %>

      <!-- Divider -->
      <div class="my-7 flex items-center gap-4">
        <div class="h-px flex-1 bg-gray-200"></div>
        <span class="text-xs text-gray-400">ACCOUNT</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>

      <!-- Cancel Account -->
      <div class="rounded-xl border border-red-100 bg-red-50 p-4">
        <h2 class="text-sm font-semibold text-red-900">
          Cancel your account
        </h2>

        <p class="mt-1 text-xs leading-relaxed text-red-700">
          This action is permanent and cannot be undone.
        </p>

        <div class="mt-4">
          <%= button_to(
            "Cancel my account",
            registration_path(resource_name),
            method: :delete,
            data: {
              turbo_confirm: "Are you sure you want to cancel your account?"
            },
            class: "w-full cursor-pointer rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-red-600 transition hover:bg-red-600 hover:text-white"
          ) %>
        </div>
      </div>

      <!-- Back -->
      <div class="mt-6 text-center">
        <%= link_to "← Back",
            :back,
            class: "text-sm font-medium text-gray-500 transition hover:text-black" %>
      </div>

    </div>

  </div>
</div>